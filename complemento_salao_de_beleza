USE salao_beleza;

-- =====================================================================
-- ITEM 3 - NORMALIZAÇÃO (até a 3FN)
-- 1FN: todas as colunas guardam um único valor (nada de listas).
-- 2FN: a única chave composta é a de agendamento_servico, e
--      valor_cobrado depende do par (agendamento, serviço) inteiro.
-- 3FN: em todas as tabelas, cada coluna depende só da chave primária.
--      Ex.: o nome do cliente e da profissional NÃO se repetem em
--      agendamento; ficam nas suas tabelas e são buscados por JOIN.
--
-- DECISÃO DE NORMALIZAÇÃO: tabela agendamento_servico.
-- Problema evitado: guardar os serviços dentro de agendamento, em
-- colunas servico1, servico2, servico3. Isso quebra a 1FN: limita a 3
-- serviços, deixa colunas vazias e complica consultas como "quem fez
-- Manicure?". Com a tabela de ligação, cada serviço é uma linha, sem
-- limite e sem desperdício.
-- Decisão relacionada: valor_cobrado guarda o preço do momento. Se o
-- preço do catálogo (servico.valor) mudar, o histórico não muda.
-- (demonstrado no UPDATE do ITEM 6)
-- =====================================================================

-- =====================================================================
-- ITEM 4 - ÁLGEBRA RELACIONAL
-- Símbolos: σ seleção (WHERE) | π projeção (SELECT) | ⨝ junção (JOIN)
--           γ agrupamento (GROUP BY com SUM, COUNT...)
--
-- CONSULTA 1 - agenda de um dia
--   π c.nome, a.horario, p.nome, a.status (
--     σ a.data_agendamento = '2026-10-05' (
--       (Agendamento a ⨝ a.codigo_cliente = c.codigo_cliente Cliente c)
--         ⨝ a.codigo_profissional = p.codigo_profissional Profissional p ) )
--   SQL:
--   SELECT c.nome, a.horario, p.nome, a.status
--   FROM agendamento a
--   JOIN cliente c      ON a.codigo_cliente = c.codigo_cliente
--   JOIN profissional p ON a.codigo_profissional = p.codigo_profissional
--   WHERE a.data_agendamento = '2026-10-05';
--   Esperado: Ana Paula | 14:00 | Camila Souza | Concluído
--
-- CONSULTA 2 - receita por profissional, só a partir de 100  (EXPLICADA)
--   σ receita >= 100 (
--     p.codigo_profissional, p.nome γ SUM(asv.valor_cobrado) → receita (
--       σ a.status = 'Concluído' (
--         (Profissional p ⨝ p.codigo_profissional = a.codigo_profissional Agendamento a)
--           ⨝ a.codigo_agendamento = asv.codigo_agendamento AgendamentoServico asv ) ) )
--   SQL: é a consulta com GROUP BY/HAVING do ITEM 6.
--   Esperado: Camila Souza | 140.00
--   Explicação:
--   1) Junções: ligam a profissional aos seus agendamentos e aos serviços
--      de cada um. Cada linha = "profissional + um serviço feito".
--      O agendamento 1 (corte + hidratação) gera 2 linhas.
--   2) Seleção (status = 'Concluído'): só atendimento realizado vira
--      receita. Sobram o agendamento 1 (Camila, 80 + 60) e o 2 (Fernanda, 50).
--   3) Agrupamento (γ): soma o valor_cobrado por profissional.
--      Camila = 140, Fernanda = 50.
--   4) Seleção final (receita >= 100): é o HAVING. Vem depois do
--      agrupamento porque filtra o resultado da soma. Fernanda sai.
--
-- CONSULTA 3 - clientes com pagamento pendente
--   π c.nome, a.data_agendamento, pg.valor (
--     σ pg.status = 'Pendente' (
--       (Cliente c ⨝ c.codigo_cliente = a.codigo_cliente Agendamento a)
--         ⨝ a.codigo_agendamento = pg.codigo_agendamento Pagamento pg ) )
--   SQL:
--   SELECT c.nome, a.data_agendamento, pg.valor
--   FROM cliente c
--   JOIN agendamento a ON a.codigo_cliente = c.codigo_cliente
--   JOIN pagamento pg  ON pg.codigo_agendamento = a.codigo_agendamento
--   WHERE pg.status = 'Pendente';
--   Esperado (dados originais): Ana Paula | 2026-10-08 | 80.00
-- =====================================================================

-- =====================================================================
-- ITEM 5 - DDL: ALTER TABLE (UNIQUE e CHECK = regras de negócio)
-- =====================================================================

-- E-mail não pode se repetir (NULL pode: nem todo mundo informa e-mail)
ALTER TABLE cliente
    ADD CONSTRAINT uq_cliente_email UNIQUE (email);

ALTER TABLE profissional
    ADD CONSTRAINT uq_profissional_email UNIQUE (email);

-- Serviço precisa ter duração positiva e valor não negativo
ALTER TABLE servico
    ADD CONSTRAINT chk_servico_duracao CHECK (duracao_minutos > 0),
    ADD CONSTRAINT chk_servico_valor   CHECK (valor >= 0);

-- Agendamento só pode ter um dos três status do salão
ALTER TABLE agendamento
    ADD CONSTRAINT chk_agendamento_status
    CHECK (status IN ('Agendado', 'Concluído', 'Cancelado'));

ALTER TABLE agendamento_servico
    ADD CONSTRAINT chk_as_valor CHECK (valor_cobrado >= 0);

-- Pagamento: valor positivo, status e forma válidos,
-- e "Pago" obrigatoriamente com data de pagamento
ALTER TABLE pagamento
    ADD CONSTRAINT chk_pagamento_valor  CHECK (valor > 0),
    ADD CONSTRAINT chk_pagamento_status CHECK (status IN ('Pendente', 'Pago', 'Cancelado')),
    ADD CONSTRAINT chk_pagamento_forma  CHECK (forma_pagamento IS NULL
                                               OR forma_pagamento IN ('Pix', 'Cartão', 'Dinheiro')),
    ADD CONSTRAINT chk_pagamento_data   CHECK (status <> 'Pago' OR data_pagamento IS NOT NULL);

