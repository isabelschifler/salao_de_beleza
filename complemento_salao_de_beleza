-- =====================================================================
-- ITEM 9 - TRIGGER - impede dois atendimentos da mesma profissional no
-- mesmo dia e horário (regra de negócio: ninguém atende duas pessoas
-- ao mesmo tempo). Agendamentos cancelados não contam.
-- =====================================================================
DROP TRIGGER IF EXISTS trg_agendamento_sem_conflito;

DELIMITER $$
CREATE TRIGGER trg_agendamento_sem_conflito
BEFORE INSERT ON agendamento
FOR EACH ROW
BEGIN
    IF NEW.status <> 'Cancelado' AND EXISTS (
        SELECT 1
          FROM agendamento
         WHERE codigo_profissional = NEW.codigo_profissional
           AND data_agendamento    = NEW.data_agendamento
           AND horario             = NEW.horario
           AND status <> 'Cancelado'
    ) THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Conflito: a profissional já tem atendimento neste dia e horário.';
    END IF;
END$$
DELIMITER ;

