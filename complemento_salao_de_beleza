-- =====================================================================
-- ITEM 10 - ÍNDICE
-- Consultas por dia (agenda da recepção) filtram por data_agendamento e
-- ordenam por horario. O índice composto guarda os agendamentos já
-- organizados por (data, horário), evitando ler a tabela inteira.
-- =====================================================================
CREATE INDEX idx_agendamento_data_horario
    ON agendamento (data_agendamento, horario);

-- ANTES (ignorando o índice): esperado type = ALL (lê a tabela toda)
EXPLAIN SELECT codigo_agendamento, horario, status
FROM agendamento IGNORE INDEX (idx_agendamento_data_horario)
WHERE data_agendamento = '2026-10-05'
ORDER BY horario;

-- DEPOIS (usando o índice): esperado type = ref, key = idx_agendamento_data_horario
EXPLAIN SELECT codigo_agendamento, horario, status
FROM agendamento FORCE INDEX (idx_agendamento_data_horario)
WHERE data_agendamento = '2026-10-05'
ORDER BY horario;

