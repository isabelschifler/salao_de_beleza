FROM cliente
WHERE codigo_cliente IN (SELECT codigo_cliente
                         FROM agendamento
                         WHERE status = 'Concluído');

-- SELECT com GROUP BY e HAVING: receita por profissional (só >= 100)
SELECT p.nome AS profissional,
       COUNT(DISTINCT a.codigo_agendamento) AS atendimentos,
       SUM(asv.valor_cobrado)               AS receita
FROM profissional p
JOIN agendamento a           ON a.codigo_profissional = p.codigo_profissional
JOIN agendamento_servico asv ON asv.codigo_agendamento = a.codigo_agendamento
WHERE a.status = 'Concluído'
GROUP BY p.codigo_profissional, p.nome
HAVING SUM(asv.valor_cobrado) >= 100;

-- =====================================================================
-- ITEM 7 - VIEW: vw_agenda_recepcao + usuário da recepção
-- Contexto: a recepcionista precisa ver a agenda do dia (cliente,
-- profissional, serviços, total e situação do pagamento), mas não deve
-- ver nem alterar as tabelas originais. Por isso ela consulta só a view.
-- =====================================================================

-- Criação da view (junta 6 tabelas; GROUP_CONCAT lista os serviços numa
-- linha só; COALESCE mostra 'Sem pagamento' quando não há pagamento)
CREATE OR REPLACE VIEW vw_agenda_recepcao AS
SELECT a.codigo_agendamento,
       a.data_agendamento,
       a.horario,
       c.nome                                   AS cliente,
       p.nome                                   AS profissional,
       GROUP_CONCAT(s.nome ORDER BY s.nome SEPARATOR ', ') AS servicos,
       SUM(asv.valor_cobrado)                   AS total_atendimento,
       a.status                                 AS status_agendamento,
       COALESCE(pg.status, 'Sem pagamento')     AS status_pagamento
FROM agendamento a
JOIN cliente c               ON a.codigo_cliente = c.codigo_cliente
JOIN profissional p          ON a.codigo_profissional = p.codigo_profissional
JOIN agendamento_servico asv ON a.codigo_agendamento = asv.codigo_agendamento
JOIN servico s               ON asv.codigo_servico = s.codigo_servico
LEFT JOIN pagamento pg       ON a.codigo_agendamento = pg.codigo_agendamento
GROUP BY a.codigo_agendamento, a.data_agendamento, a.horario,
         c.nome, p.nome, a.status, pg.status;

-- Usuário da recepção: só pode consultar a view, nenhuma tabela original.
-- (precisa vir DEPOIS da criação da view)
CREATE USER IF NOT EXISTS 'recepcao'@'localhost' IDENTIFIED BY 'senha123';
GRANT SELECT ON salao_beleza.vw_agenda_recepcao TO 'recepcao'@'localhost';
FLUSH PRIVILEGES;

-- Testando a view
SELECT * FROM vw_agenda_recepcao;

-- Quem ainda precisa pagar (atendimentos que não foram cancelados)
SELECT codigo_agendamento, data_agendamento, cliente,
       total_atendimento, status_pagamento
FROM vw_agenda_recepcao
WHERE status_agendamento <> 'Cancelado'
  AND status_pagamento IN ('Pendente', 'Sem pagamento')
ORDER BY data_agendamento;

-- =====================================================================
-- ITEM 8 - FUNCTION - total de um agendamento
-- Soma o valor_cobrado de todos os serviços do agendamento.
-- Retorna 0 se o agendamento não existir ou não tiver serviços.
-- =====================================================================
DROP FUNCTION IF EXISTS fn_total_agendamento;

DELIMITER $$
CREATE FUNCTION fn_total_agendamento(p_codigo_agendamento INT)
RETURNS DECIMAL(10,2)
READS SQL DATA
BEGIN
    DECLARE v_total DECIMAL(10,2);

    SELECT COALESCE(SUM(valor_cobrado), 0)
      INTO v_total
      FROM agendamento_servico
     WHERE codigo_agendamento = p_codigo_agendamento;

    RETURN v_total;
END$$
DELIMITER ;

-- Como executar (esperado: 140.00, 50.00, 80.00, 120.00, 55.00, e 0.00 para o 999)
SELECT fn_total_agendamento(1) AS total_ag1;
SELECT codigo_agendamento, fn_total_agendamento(codigo_agendamento) AS total
FROM agendamento;
SELECT fn_total_agendamento(999) AS inexistente;

-- =====================================================================
-- ITEM 8 - STORED PROCEDURE - registrar pagamento de um agendamento
-- Regras: agendamento deve existir e não estar cancelado, ter serviços e
-- ainda não estar pago. Se já existe pagamento "Pendente", ele é
-- quitado; se não existe pagamento, ele é criado.
-- Tudo dentro de uma transação: ou grava certo, ou desfaz.
-- =====================================================================
DROP PROCEDURE IF EXISTS sp_registrar_pagamento;

DELIMITER $$
CREATE PROCEDURE sp_registrar_pagamento(
    IN p_codigo_agendamento INT,
    IN p_forma_pagamento    VARCHAR(30)
)
BEGIN
    DECLARE v_total      DECIMAL(10,2);
    DECLARE v_status_ag  VARCHAR(20);
    DECLARE v_status_pag VARCHAR(20);

    -- Qualquer erro: desfaz tudo e repassa o erro para quem chamou
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT status INTO v_status_ag
      FROM agendamento
     WHERE codigo_agendamento = p_codigo_agendamento
       FOR UPDATE;

    IF v_status_ag IS NULL THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Agendamento não encontrado.';
    ELSEIF v_status_ag = 'Cancelado' THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Agendamento cancelado não pode ser pago.';
    END IF;

    SET v_total = fn_total_agendamento(p_codigo_agendamento);
    IF v_total <= 0 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Agendamento sem serviços.';
    END IF;

    SELECT status INTO v_status_pag
      FROM pagamento
     WHERE codigo_agendamento = p_codigo_agendamento
       FOR UPDATE;

    IF v_status_pag IS NULL THEN
        INSERT INTO pagamento (data_pagamento, valor, forma_pagamento, status, codigo_agendamento)
        VALUES (CURDATE(), v_total, p_forma_pagamento, 'Pago', p_codigo_agendamento);
    ELSEIF v_status_pag = 'Pago' THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Este agendamento já foi pago.';
    ELSE
        UPDATE pagamento
           SET data_pagamento  = CURDATE(),
               valor           = v_total,
               forma_pagamento = p_forma_pagamento,
               status          = 'Pago'
         WHERE codigo_agendamento = p_codigo_agendamento;
    END IF;

    COMMIT;

    SELECT * FROM pagamento WHERE codigo_agendamento = p_codigo_agendamento;
END$$
DELIMITER ;

-- Como executar:
-- Agendamento 3 tinha pagamento Pendente -> vira Pago, valor 80.00, data de hoje
CALL sp_registrar_pagamento(3, 'Pix');
-- Agendamento 4 não tinha pagamento -> cria um novo, valor 120.00, status Pago
CALL sp_registrar_pagamento(4, 'Cartão');

